# Anthropic API 키 (https://console.anthropic.com/settings/keys 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# Blogger 블로그 ID (setup_blogger.py 실행하면 자동으로 알려줌)
BLOG_ID=

# 초안 저장 위치 (비워두면 이 폴더의 output/). 경로는 역슬래시 대신 슬래시를 쓴다
OUTPUT_DIR=G:/내 드라이브/blog-drafts

# Pexels 무료 이미지 API 키 (https://www.pexels.com/api/ 에서 발급, 없으면 비워둠)
PEXELS_API_KEY=

# 하루에 만들 초안 개수
DRAFTS_PER_DAY=2
